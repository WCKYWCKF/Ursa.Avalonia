<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../Package.props"/>

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <PackageId>Irihi.Ursa</PackageId>
        <PackageIcon>irihi.png</PackageIcon>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <TargetFramework>net8.0</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)"/>
        <PackageReference Include="Irihi.Avalonia.Shared" Version="0.2.3" />
        <PackageReference Include="Irihi.Avalonia.Shared.Contracts" Version="0.2.3" />
    </ItemGroup>

    <ItemGroup>
        <None Include="irihi.png" Pack="true" PackagePath=""/>
    </ItemGroup>
</Project>
